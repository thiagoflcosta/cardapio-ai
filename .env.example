# Copie este arquivo para .env e preencha.

# Opção 1 (grátis, roda no seu computador): Ollama
# Instale em ollama.com, baixe um modelo e coloque o nome dele em LLM_MODELO.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODELO=
LLM_API_KEY=

# Opção 2: qualquer API compatível com a da OpenAI.
# Deixe LLM_BASE_URL vazio para usar a própria OpenAI e preencha LLM_API_KEY.
# LLM_BASE_URL=
# LLM_MODELO=
# LLM_API_KEY=

# 1 = pede JSON puro ao modelo (recomendado). Use 0 se o provedor não aceitar.
LLM_JSON_MODE=1

# Opcional: preço em US$ por 1 milhão de tokens, para estimar o custo na avaliação.
LLM_CUSTO_ENTRADA_1M=
LLM_CUSTO_SAIDA_1M=
